# ─── Gigachad environment ─────────────────────────────────────────────────────
# Every variable below is validated at boot by apps/api/src/env.ts. The process
# refuses to start on a missing required value rather than failing later.
# Reference: docs/10-deployment.md.
#
# Copy to .env and fill in. Replace APEX_DOMAIN with your apex domain
# (e.g. example.com) everywhere it appears.

# ─── Compose ──────────────────────────────────────────────────────────────────
# On the VM, select the production overlay. Omit locally so Docker Compose
# auto-loads compose.override.yaml instead. The deploy command is identical in
# both places; this variable is what decides its meaning.
#COMPOSE_FILE=compose.yaml:compose.prod.yaml

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ─── Data ─────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=replace-me
# Host is the compose service name. connection_limit is deliberate: Prisma's
# default pool scales with CPU count and the API and worker each open their own,
# which together exhaust postgres max_connections=25 (docs/10-deployment.md).
DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/gigachad?schema=public&connection_limit=8
REDIS_URL=redis://redis:6379

# ─── Sessions and origins ─────────────────────────────────────────────────────
# 32+ random bytes. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me
# Must be the apex shared with the dashboard, with the leading dot, so
# app.<apex> -> api.<apex> requests are same-site and the HttpOnly session cookie
# is sent normally. Leave EMPTY for local development to get a host-only cookie.
COOKIE_DOMAIN=.APEX_DOMAIN
API_URL=https://api.APEX_DOMAIN
# Exact origin, used for CORS and as the CSRF origin allowlist. Never a wildcard.
DASHBOARD_ORIGIN=https://app.APEX_DOMAIN

# ─── Public knowledge base ────────────────────────────────────────────────────
KB_HOST=kb.APEX_DOMAIN
# The hostname customers point their CNAME at. Must be DNS-only behind a
# proxying CDN, or the HTTP-01 challenge is intercepted and issuance fails.
KB_CNAME_TARGET=kb.APEX_DOMAIN

# ─── Email (Brevo) ────────────────────────────────────────────────────────────
# Each workspace's support address is <workspace-slug>@inbound.<domain>.
INBOUND_EMAIL_DOMAIN=inbound.APEX_DOMAIN
# Leave blank to run without email: inbound webhooks then fail signature
# verification closed and outbound sends report EMAIL_SEND_FAILED.
BREVO_API_KEY=
BREVO_WEBHOOK_SIGNING_SECRET=
# From must be on the domain Brevo authenticated, which is deliberately NOT the
# inbound domain — see docs/07-email.md.
MAIL_FROM=support@APEX_DOMAIN

# ─── AI ───────────────────────────────────────────────────────────────────────
# Omit to run with AI disabled: the summary panel reports AI unavailable and
# everything else keeps working.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SUMMARY_MIN_MESSAGES=6
