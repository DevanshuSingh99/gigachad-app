# Caddy terminates TLS for the API and the public knowledge base, and issues
# certificates on demand for verified customer hostnames.
#
# The ask endpoint is the whole security model for on-demand issuance: it returns
# 200 only for a custom_domains row with status = VERIFIED. Without it, anyone
# pointing a DNS record at this VM triggers a Let's Encrypt request and the
# deployment becomes an open issuance relay that the CA will rate-limit off —
# taking every real custom domain down with it. See docs/09-security.md.

{
	# Caddy 2.10+ dropped interval/burst here. Issuance is gated by ask
	# (200 only for VERIFIED hostnames) plus the API's own rate limits.
	on_demand_tls {
		ask http://api:3000/internal/tls/ask
	}
}

# /internal/* (the ask endpoint above, plus anything else mounted there) must
# never be reachable from outside the Docker network — that's the network
# boundary docs/09-security.md and the route's own doc comment both assume.
# Caddy's own on_demand_tls `ask` call above hits the api container directly
# over the compose network, not through these public site blocks, so blocking
# the path here doesn't affect it — this only stops an external client from
# reaching it through the reverse proxy.
(block_internal) {
	handle /internal/* {
		respond 404
	}
}

gigachad-api.devjs.in {
	import block_internal
	reverse_proxy api:3000
}

gigachad-kb.devjs.in {
	import block_internal
	reverse_proxy api:3000
}

# Verified customer domains. The certificate is issued at the first handshake,
# gated by the ask endpoint above.
https:// {
	tls {
		on_demand
	}
	import block_internal
	reverse_proxy api:3000
}
