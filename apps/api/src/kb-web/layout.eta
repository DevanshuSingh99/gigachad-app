<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!--
    CSP for the public KB. No inline scripts, images from https only,
    no framing (frame-ancestors 'none'). Sanitized article HTML is safe
    within this policy: it uses no script, no inline style, no data: URIs.
    docs/09-security.md.
  -->
  <meta http-equiv="Content-Security-Policy"
        content="default-src 'self'; img-src https:; style-src 'self' 'unsafe-inline'; script-src 'none'; frame-ancestors 'none';" />
  <title><%= it.title %> – <%= it.workspaceName %> Help Center</title>
  <!--
    Built by `npm run build:css` (Tailwind v4 CLI) into dist/kb-web/styles.css
    from src/kb-web/styles.css. NOT YET SERVED: there is no static-file route
    for dist/kb-web in apps/api/src/app.ts (out of scope here — app.ts is owned
    elsewhere). Recommended wiring, once added: mount
    `express.static(path.join(__dirname, '../kb-web'))` at a path that can
    never collide with a `:workspaceSlug` segment — e.g.
    `apiV1.use('/public/assets/kb', express.static(...))`, serving this file at
    `GET /api/v1/public/assets/kb/styles.css` ("assets" is already in
    RESERVED_SLUGS, so no real workspace slug can ever shadow it). Until that
    route exists this link 404s harmlessly and the inline <style> block below —
    kept deliberately, as a fallback — is what actually renders the page.
  -->
  <link rel="stylesheet" href="/api/v1/public/assets/kb/styles.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --blue: #2563eb; --blue-dark: #1d4ed8;
      --gray-50: #f8fafc; --gray-100: #f1f5f9; --gray-200: #e2e8f0;
      --gray-500: #64748b; --gray-700: #334155; --gray-900: #0f172a;
      font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
      color: var(--gray-900); background: #fff;
    }
    a { color: var(--blue); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .site-header {
      background: #fff; border-bottom: 1px solid var(--gray-200);
      padding: 0.875rem 1.5rem; display: flex; align-items: center; gap: 1rem;
    }
    .site-header__name { font-weight: 600; color: var(--gray-900); font-size: 1rem; }
    .site-header__tagline { color: var(--gray-500); font-size: 0.875rem; }
    .hero {
      background: var(--gray-50); border-bottom: 1px solid var(--gray-200);
      padding: 2.5rem 1.5rem; text-align: center;
    }
    .hero h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem; }
    .search-form { display: flex; gap: 0.5rem; max-width: 36rem; margin: 0 auto; }
    .search-input {
      flex: 1; padding: 0.625rem 0.875rem; border: 1px solid var(--gray-200);
      border-radius: 0.5rem; font-size: 0.9375rem; outline: none;
    }
    .search-input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px #dbeafe; }
    .btn {
      padding: 0.625rem 1.25rem; background: var(--blue); color: #fff;
      border: none; border-radius: 0.5rem; font-size: 0.9375rem; cursor: pointer;
    }
    .btn:hover { background: var(--blue-dark); }
    .container { max-width: 56rem; margin: 0 auto; padding: 2rem 1.5rem; }
    .layout { display: grid; gap: 2rem; grid-template-columns: 1fr; }
    @media (min-width: 768px) { .layout { grid-template-columns: 14rem 1fr; } }
    .sidebar h2 { font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
      letter-spacing: 0.05em; color: var(--gray-500); margin-bottom: 0.75rem; }
    .sidebar ul { list-style: none; }
    .sidebar li { margin-bottom: 0.25rem; }
    .sidebar a { color: var(--gray-700); font-size: 0.875rem; }
    .sidebar a.active { color: var(--blue); font-weight: 600; }
    .article-list { list-style: none; }
    .article-item {
      padding: 1rem 0; border-bottom: 1px solid var(--gray-100);
    }
    .article-item:last-child { border-bottom: none; }
    .article-item a { font-size: 1rem; font-weight: 500; color: var(--gray-900); }
    .article-item a:hover { color: var(--blue); }
    .article-item .meta { font-size: 0.8125rem; color: var(--gray-500); margin-top: 0.25rem; }
    .article-body h1,.article-body h2,.article-body h3 { margin: 1.5rem 0 0.75rem; font-weight: 700; }
    .article-body h1 { font-size: 1.5rem; } .article-body h2 { font-size: 1.25rem; }
    .article-body p { margin-bottom: 1rem; line-height: 1.7; }
    .article-body ul,.article-body ol { margin: 0 0 1rem 1.5rem; line-height: 1.7; }
    .article-body pre {
      background: var(--gray-100); border-radius: 0.375rem;
      padding: 1rem; overflow-x: auto; margin-bottom: 1rem; font-size: 0.875rem;
    }
    .article-body blockquote {
      border-left: 3px solid var(--gray-200); padding-left: 1rem;
      color: var(--gray-700); margin-bottom: 1rem;
    }
    .article-body table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
    .article-body th,.article-body td {
      border: 1px solid var(--gray-200); padding: 0.5rem 0.75rem; text-align: left;
    }
    .article-body th { background: var(--gray-50); font-weight: 600; }
    .breadcrumb { font-size: 0.875rem; color: var(--gray-500); margin-bottom: 1.5rem; }
    .breadcrumb a { color: var(--gray-500); }
    .breadcrumb span { margin: 0 0.5rem; }
    .section-header { margin-bottom: 1.5rem; }
    .section-header h2 { font-size: 1.25rem; font-weight: 700; }
    .empty { text-align: center; color: var(--gray-500); padding: 3rem 0; }
    .site-footer { border-top: 1px solid var(--gray-200); padding: 1.5rem;
      text-align: center; font-size: 0.8125rem; color: var(--gray-500); }
  </style>
</head>
<body>
  <header class="site-header">
    <a href="<%= it.kbRoot %>" class="site-header__name"><%= it.workspaceName %></a>
    <span class="site-header__tagline">Help Center</span>
  </header>
  <%~ it.body %>
  <footer class="site-footer">Powered by Gigachad</footer>
</body>
</html>
