# Baked into BOTH the loader and panel bundles at build time (esbuild's
# `define`), the same pattern as the dashboard's NEXT_PUBLIC_* variables. Not
# relayed panel-to-loader via postMessage: that channel crosses an
# unauthenticatable origin boundary (the host page), so the panel reads its own
# copy of these constants directly rather than trusting whatever an `init`
# message claims (apps/widget/src/panel/main.ts).

WIDGET_API_URL=http://localhost:3000
WIDGET_WS_URL=http://localhost:3000

# Production:
#WIDGET_API_URL=https://api.APEX_DOMAIN
#WIDGET_WS_URL=https://api.APEX_DOMAIN
