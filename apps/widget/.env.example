# Baked into the loader bundle at build time (esbuild's `define`), the same
# pattern as the dashboard's NEXT_PUBLIC_* variables. The panel needs no build
# of its own configuration: the loader relays these to it in the `init`
# postMessage, so there is exactly one place these are set.

WIDGET_API_URL=http://localhost:3000
WIDGET_WS_URL=http://localhost:3000

# Production:
#WIDGET_API_URL=https://api.APEX_DOMAIN
#WIDGET_WS_URL=https://api.APEX_DOMAIN
